{
  "name": "cfward",
  "version": "0.1.3",
  "description": "Manage multiple Cloudflare accounts across projects, with tokens encrypted at rest",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardogottheil/cfward.git"
  },
  "homepage": "https://github.com/ricardogottheil/cfward#readme",
  "bugs": "https://github.com/ricardogottheil/cfward/issues",
  "author": "Ricardo Gottheil",
  "keywords": [
    "cloudflare",
    "wrangler",
    "cli",
    "credentials",
    "keychain"
  ],
  "publishConfig": {
    "provenance": true
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "bin": {
    "cfward": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@stricli/core": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
